# Kopyalayın: cp .env.example .env  (make up bunu ilk seferde kendisi yapar)

# Apache bu kullanıcı kimliğiyle çalışır (Linux'ta `id -u` / `id -g`). Değiştirirseniz: make build
UID=1000
GID=1000

# MariaDB root şifresi. Sadece İLK kurulumda (volume boşken) uygulanır.
MYSQL_ROOT_PASSWORD=root

# Portlar
WEB84_PORT=80
WEB74_PORT=81
WEB85_PORT=82
DB103_PORT=3306
DBLATEST_PORT=3307
PMA_PORT=9000

# DB ve phpMyAdmin hangi arayüzden dinlesin. 0.0.0.0 = LAN + Tailscale; 127.0.0.1 = sadece bu makine
DB_BIND=0.0.0.0
PMA_BIND=0.0.0.0
